# Suffix aliases — type a filename to open it with the right tool
# e.g. typing "data.json" runs "jless data.json"

alias -s json=jless
alias -s md=bat
alias -s txt=bat
alias -s log=bat
alias -s go='$EDITOR'
alias -s rs='$EDITOR'
alias -s py='$EDITOR'
alias -s js='$EDITOR'
alias -s ts='$EDITOR'
alias -s php='$EDITOR'
alias -s html=open
