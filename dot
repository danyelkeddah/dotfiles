#!/usr/bin/env bash
# dot — installs, configures, upgrades and removes the packages in this repo.
#
# A package is a folder with a setup.sh that defines functions; dot calls the
# ones it needs:
#
#   install()      get the software            uninstall()     remove it
#   configure()    link config, apply settings unconfigure()   undo that
#   upgrade()      move to a newer version
#   sync_secrets() write secret files          remove_secrets()
#
# All are optional; a package defines the ones that mean something for it.
# Code outside the functions runs every time the file is loaded — that is
# where only_on and shared variables go.
#
#   dot install     = install()     then configure()
#   dot uninstall   = unconfigure() then uninstall()
#
# Written to run on bash 3.2 (stock macOS): no associative arrays, and no
# expanding possibly-empty arrays under `set -u`.
set -euo pipefail

export DOTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$DOTS/_shared/ui.sh"
source "$DOTS/_shared/os.sh"
source "$DOTS/_shared/platform.sh"
source "$DOTS/_shared/pkg.sh"

# Tools one package installs must be findable by the next one in the same run,
# before any shell has been restarted. Same places zsh/config/zsh/config/path.zsh
# puts on PATH, plus mise's shims (what `mise activate` provides in zsh).
export PNPM_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$HOME/.cargo/bin:$PNPM_HOME:$PNPM_HOME/bin:$PATH"
# a freshly installed Homebrew (Apple Silicon keeps it outside the default PATH)
[ -d /opt/homebrew/bin ] && export PATH="/opt/homebrew/bin:$PATH"

export -f log_ok log_err log_info log_warn log_header \
  platform_matches only_on \
  symlink unlink_dot ui_confirm \
  as_root pkg_installed pkg_install pkg_uninstall apt_add_repo

# These always run first on a full install, in this order.
PREFLIGHT="homebrew mise packages"

# Space-padded name lists, e.g. " homebrew tmux ".
COMPLETED=" "
IN_PROGRESS=" "

# One line per package that ran: "name|ok|seconds" (or failed, skipped).
RESULTS=""

# -y / --yes: don't ask, just do it
YES=""

# call_fn exits with this when the package defines none of the functions asked for
RC_NO_FN=127

# ── Packages ──────────────────────────────────────────────────────────────────

# every package name, preflight first, then alphabetical
all_packages() {
  local name file
  for name in $PREFLIGHT; do
    [ -f "$DOTS/$name/setup.sh" ] && echo "$name"
  done
  for file in "$DOTS"/*/setup.sh; do
    [ -f "$file" ] || continue
    name="$(basename "$(dirname "$file")")"
    [[ " $PREFLIGHT " == *" $name "* ]] || echo "$name"
  done
}

# applies <package> — does this package apply to this machine?
# Loads the file and sees whether only_on stopped it. No function is called,
# so nothing is installed or changed.
applies() {
  local probe="$DOT_RUN_DIR/probe"
  rm -rf "$probe"
  mkdir -p "$probe"
  DOT_RUN_DIR="$probe" bash -c 'source "$1"' _ "$DOTS/$1/setup.sh" >/dev/null 2>&1
  [ ! -f "$probe/skipped" ]
}

# packages_with <function>... — packages that apply here and define at least
# one of the functions. One look per package; used by tab completion.
packages_with() {
  local name probe="$DOT_RUN_DIR/probe"
  for name in $(all_packages); do
    rm -rf "$probe"
    mkdir -p "$probe"
    DOT_RUN_DIR="$probe" bash -c '
      source "$1" >/dev/null 2>&1
      shift
      for fn in "$@"; do declare -F "$fn" >/dev/null && exit 0; done
      exit 1
    ' _ "$DOTS/$name/setup.sh" "$@" || continue
    [ -f "$probe/skipped" ] || echo "$name"
  done
}

# every package that applies here, in the same order as all_packages
applicable_packages() {
  local name
  for name in $(all_packages); do
    applies "$name" && echo "$name"
  done
}

# stop before doing anything if a name on the command line isn't a package
check_names() {
  local name
  for name in "$@"; do
    if [ ! -f "$DOTS/$name/setup.sh" ]; then
      log_err "unknown package: $name (see: dot --list)"
      exit 1
    fi
  done
}

# the names given on the command line, or every package that applies here
# when none were given
selected_packages() {
  if [ $# -eq 0 ]; then
    applicable_packages
  else
    printf '%s\n' "$@"
  fi
}

# has_fn <package> <function> — does the package define this function?
# Asks bash itself, by loading the file and looking: no guessing from the text.
# only_on is switched off for the look, so a package that doesn't apply to this
# machine can still be asked.
has_fn() {
  bash -c 'only_on() { :; }; source "$1" >/dev/null 2>&1; declare -F "$2" >/dev/null' \
    _ "$DOTS/$1/setup.sh" "$2"
}

# call_fn <package> <function>... — run the given functions of a package, in
# order, skipping the ones it doesn't define. They run in their own bash, so
# nothing a package sets or cd's into leaks into the next one, and each stops
# at its first failing command.
call_fn() {
  local name="$1"
  shift
  bash -c '
    set -eo pipefail
    source "$1"
    shift
    ran=""
    for fn in "$@"; do
      if declare -F "$fn" >/dev/null; then
        "$fn"
        ran=1
      fi
    done
    [ -n "$ran" ] || exit '"$RC_NO_FN"'
  ' _ "$DOTS/$name/setup.sh" "$@"
}

deps_of() {
  local line
  line="$(grep '^DEPS=' "$DOTS/$1/setup.sh" 2>/dev/null | head -1 || true)"
  [ -n "$line" ] || return 0
  echo "$line" | sed 's/^DEPS=(\(.*\)).*/\1/'
}

# ── running a package ─────────────────────────────────────────────────────────

# record <package> <ok|failed|skipped> <seconds> — remembered for the summary
record() { RESULTS="$RESULTS$1|$2|$3"$'\n'; }

# run_pkg <package> <function>... — run those functions of one package under
# its own header, then say how it went and how long it took
run_pkg() {
  local name="$1" rc=0 start=$SECONDS secs
  shift

  log_header "$name"

  rm -f "$DOT_RUN_DIR/skipped"
  call_fn "$name" "$@" || rc=$?
  secs=$((SECONDS - start))

  if [ "$rc" = "$RC_NO_FN" ]; then
    log_info "nothing to do — $name has no $(echo "$*" | sed 's/ /() or /g')()"
    record "$name" skipped "$secs"
  elif [ "$rc" != 0 ]; then
    log_err "$name failed · ${secs}s"
    record "$name" failed "$secs"
    return 1
  elif [ -f "$DOT_RUN_DIR/skipped" ]; then
    record "$name" skipped "$secs"   # only_on left the marker and said why
  else
    log_ok "$name · ${secs}s"
    record "$name" ok "$secs"
  fi
}

# ── install ───────────────────────────────────────────────────────────────────

install_pkg() {
  local name="$1" dep

  [[ "$COMPLETED" == *" $name "* ]] && return 0

  if [ ! -f "$DOTS/$name/setup.sh" ]; then
    log_err "unknown package: $name"
    return 1
  fi

  IN_PROGRESS="$IN_PROGRESS$name "

  # dependencies first, each under its own header
  for dep in $(deps_of "$name"); do
    if [[ "$IN_PROGRESS" == *" $dep "* ]]; then
      log_err "circular dep detected: $name → $dep"
      return 1
    fi
    install_pkg "$dep" || return 1
  done

  IN_PROGRESS="${IN_PROGRESS/ $name / }"
  COMPLETED="$COMPLETED$name "

  run_pkg "$name" install configure
}

run_install() {
  local name names

  if [ $# -gt 0 ]; then
    names="$*"
    # named packages still need brew to exist on a fresh Mac
    [ "$DOT_PKG" = brew ] && [ -f "$DOTS/homebrew/setup.sh" ] && names="homebrew $names"
  elif [ -n "$YES" ] || [ -z "$UI_ASK" ]; then
    names="$(packages_with install configure)"
  else
    # ui_choose says "nothing selected" itself
    names="$(ui_choose "Install which packages?" $(packages_with install configure))" || return 0
  fi

  # only a full run is long enough to outlive sudo's password timeout
  [ $# -eq 0 ] && sudo_keepalive

  # a failed package stops the run: what comes after may depend on it
  for name in $names; do
    install_pkg "$name" || break
  done
}

# ── configure / upgrade / uninstall / secrets ─────────────────────────────────

# run_fn <function> <package>... — call one function in each package that has
# it. A failure is recorded and the rest still run.
run_fn() {
  local fn="$1" name
  shift
  for name in "$@"; do
    has_fn "$name" "$fn" || continue
    run_pkg "$name" "$fn" || true
  done
}

system_upgrade() {
  local rc=0 start=$SECONDS

  log_header "system"
  if [ "$DOT_PKG" != brew ] && [ "$DOT_ROOT" = no ]; then
    log_warn "no root access — skipping system upgrade"
    record system skipped 0
    return 0
  fi
  case "$DOT_PKG" in
    brew)   { brew update && brew upgrade; } || rc=$? ;;
    apt)    { as_root apt-get update && as_root apt-get upgrade -y; } || rc=$? ;;
    pacman) as_root pacman -Syu --noconfirm || rc=$? ;;
    dnf)    as_root dnf upgrade -y || rc=$? ;;
    *)
      log_warn "no known package manager — skipping system upgrade"
      record system skipped 0
      return 0
      ;;
  esac

  if [ "$rc" = 0 ]; then
    log_ok "system · $((SECONDS - start))s"
    record system ok "$((SECONDS - start))"
  else
    log_err "system failed · $((SECONDS - start))s"
    record system failed "$((SECONDS - start))"
  fi
}

run_upgrade() {
  # the whole system only when no package was named
  if [ $# -eq 0 ]; then
    sudo_keepalive
    system_upgrade
  fi
  run_fn upgrade $(selected_packages "$@")
}

run_configure() {
  run_fn configure $(selected_packages "$@")
}

# need_names <command> <package>... — commands that undo things never default
# to "every package"
need_names() {
  if [ $# -lt 2 ]; then
    log_err "$1 needs at least one package name"
    exit 1
  fi
}

run_unconfigure() {
  local name names=""

  need_names unconfigure "$@"
  for name in "$@"; do
    if has_fn "$name" unconfigure; then
      names="$names $name"
    else
      log_warn "$name has no unconfigure() — nothing to undo"
    fi
  done
  [ -n "$names" ] || return 0

  if [ -z "$YES" ] && ! ui_confirm "Remove the config of:$names?"; then
    log_info "nothing removed"
    return 0
  fi
  run_fn unconfigure $names
}

run_uninstall() {
  local name

  need_names uninstall "$@"
  if [ -z "$YES" ] && ! ui_confirm "Remove the config AND the software of: $*?"; then
    log_info "nothing removed"
    return 0
  fi

  for name in "$@"; do
    # some software is shared with the rest of the system (git, zsh): those
    # packages have no uninstall() on purpose
    has_fn "$name" uninstall \
      || log_warn "$name has no uninstall() — only its config is removed, the software stays"
    run_pkg "$name" unconfigure uninstall || true
  done
}

run_update() {
  log_header "dotfiles"
  git -C "$DOTS" pull --ff-only
  log_ok "dotfiles up to date"
  # start again so the freshly pulled dot does the installing
  cleanup
  exec "$DOTS/dot" install --yes
}

# ── sudo ──────────────────────────────────────────────────────────────────────

# Ask for the sudo password once, up front, and keep it from timing out, so a
# long run doesn't stop for a password twenty minutes in. Only when there is a
# person to ask and this user can become root at all.
SUDO_LOOP=""
sudo_keepalive() {
  [ "$(id -u)" != 0 ] && [ "$DOT_ROOT" = yes ] && [ -n "$UI_ASK" ] || return 0
  [ -z "$SUDO_LOOP" ] || return 0

  log_info "some steps need root — asking for your password once"
  if ! sudo -v; then
    log_err "sudo is needed for this run"
    exit 1
  fi
  # refresh every 50s until dot is gone. Detached from the terminal, so a
  # leftover `sleep` can't hold `dot | tee log` open after dot has finished.
  ( while sleep 50; do
      kill -0 "$$" 2>/dev/null || exit 0
      sudo -n true 2>/dev/null || exit 0
    done ) </dev/null >/dev/null 2>&1 &
  SUDO_LOOP=$!
}

# ── info ──────────────────────────────────────────────────────────────────────

list_packages() {
  local name
  echo "Available packages:"
  for name in $(all_packages); do
    if applies "$name"; then
      echo " • $name"
    else
      echo "${UI_DIM} • $name  (not for this machine)${UI_OFF}"
    fi
  done
}

show_facts() {
  echo "os          $DOT_OS"
  echo "distro      $DOT_DISTRO"
  echo "system pkg  $DOT_PKG"
  echo "arch        $DOT_ARCH"
  echo "env         $DOT_ENV"
  echo "root        $DOT_ROOT"
  echo "bash        $BASH_VERSION"
  echo "dots        $DOTS"
}

show_help() {
  cat <<'EOF'
Usage: dot [command] [package...]

  dot                        choose packages to install (everything, if nobody
                             is there to ask)
  dot tmux zsh               install specific packages
  dot install [package...]   same: install the software, then configure it
  dot configure [package...] only link config and apply settings
  dot upgrade                upgrade the system's packages, then each package
  dot upgrade tmux           upgrade one package only (no system upgrade)
  dot unconfigure tmux       undo a package's config, keep the software
  dot uninstall tmux         undo the config, then remove the software
  dot update                 pull this repo, then install everything again
  dot run mise cleanup_old   run any one function of a package

  -y, --yes                don't ask which packages or "are you sure"

  dot --list               list available packages
  dot --facts              show what dot detected about this machine
  dot --sync-secrets [package...]    write secret files from 1Password
  dot --remove-secrets [package...]  remove them again
  dot --brew-dump          dump installed brew packages to Brewfile
  dot --brew-cleanup       remove packages not in Brewfile
  dot --help               this text

EOF
  list_packages
}

cleanup() {
  [ -n "${DOT_RUN_DIR:-}" ] && rm -rf "$DOT_RUN_DIR"
  [ -n "$SUDO_LOOP" ] && kill "$SUDO_LOOP" 2>/dev/null
  return 0
}

# the summary, when more than one thing ran, and the exit code
finish() {
  if [ "$(printf '%s' "$RESULTS" | wc -l)" -gt 1 ]; then
    log_header "summary"
    printf '%s' "$RESULTS" | ui_summary
  fi
  [[ "$RESULTS" != *"|failed|"* ]]
}

# ── main ──────────────────────────────────────────────────────────────────────

# pull -y / --yes out of the arguments, wherever it was written
n=$#
while [ "$n" -gt 0 ]; do
  arg="$1"
  shift
  n=$((n - 1))
  case "$arg" in
    -y|--yes) YES=1 ;;
    *)        set -- "$@" "$arg" ;;
  esac
done

# packages can read this to know that -y was given
export DOT_YES="$YES"

# scratch space for this run only (e.g. "apt lists already refreshed")
export DOT_RUN_DIR="$(mktemp -d)"
trap cleanup EXIT

cmd="${1:-install}"
case "$cmd" in
  --help|-h)  show_help;     exit 0 ;;
  --list)     list_packages; exit 0 ;;
  --facts)    show_facts;    exit 0 ;;
  --packages) shift; packages_with "$@"; exit 0 ;;   # for tab completion
esac

trap 'echo; log_err "interrupted"; finish || true; exit 130' INT TERM

# drop the command word; what is left are package names
case "$cmd" in
  install|configure|upgrade|unconfigure|uninstall|update|run|-*) [ $# -gt 0 ] && shift ;;
esac
# `dot run <package> <function>`: the last word is a function name, not a package
if [ "$cmd" = run ]; then
  if [ $# -ne 2 ]; then
    log_err "usage: dot run <package> <function>"
    exit 1
  fi
  check_names "$1"
else
  check_names "$@"
fi

case "$cmd" in
  install)     run_install "$@" ;;
  configure)   run_configure "$@" ;;
  upgrade)     run_upgrade "$@" ;;
  unconfigure) run_unconfigure "$@" ;;
  uninstall)   run_uninstall "$@" ;;
  update)      run_update ;;
  run)
    if has_fn "$1" "$2"; then
      run_pkg "$1" "$2" || true
    else
      log_err "$1/setup.sh has no $2()"
      exit 1
    fi
    ;;
  --sync-secrets)
    run_fn sync_secrets $(selected_packages "$@")
    ;;
  --remove-secrets)
    run_fn remove_secrets $(selected_packages "$@")
    ;;
  --brew-dump)
    log_info "dumping brew state to Brewfile..."
    brew bundle dump --force --file="$DOTS/packages/config/Brewfile"
    log_ok "Brewfile updated at $DOTS/packages/config/Brewfile"
    ;;
  --brew-cleanup)
    log_info "removing packages not in Brewfile..."
    brew bundle cleanup --force --file="$DOTS/packages/config/Brewfile"
    log_ok "cleanup done"
    ;;
  -*)
    log_err "unknown option: $cmd (see: dot --help)"
    exit 1
    ;;
  *) run_install "$@" ;;
esac

finish
